# AI Employee System - Silver Tier Configuration

# Watcher Configuration
ENABLE_FILESYSTEM_WATCHER=true
ENABLE_GMAIL_WATCHER=true
ENABLE_WHATSAPP_WATCHER=true
ENABLE_LINKEDIN_WATCHER=false  # Enable after API approval

# Polling Intervals (seconds)
FILESYSTEM_POLL_INTERVAL=2
GMAIL_POLL_INTERVAL=30
WHATSAPP_POLL_INTERVAL=30
LINKEDIN_POLL_INTERVAL=60

# Gmail API Configuration
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
GMAIL_LABELS_TO_MONITOR=INBOX,IMPORTANT
GMAIL_EXCLUDE_LABELS=SPAM,TRASH
GMAIL_MAX_RESULTS_PER_POLL=10

# LinkedIn API Configuration
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=whatsapp_session/
WHATSAPP_MONITOR_GROUPS=true
WHATSAPP_GROUP_WHITELIST=Team Chat,Project Alpha

# Approval Settings
APPROVAL_TIMEOUT_HOURS=24
AUTO_APPROVE_LOW_RISK=false

# Scheduling
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=America/New_York

# MCP Server Configuration
MCP_SERVER_PORT=8080
MCP_RATE_LIMIT_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIRECTORY=vault/Logs/

# Vault Configuration
VAULT_PATH=vault/
INBOX_PATH=vault/Inbox/
NEEDS_ACTION_PATH=vault/Needs_Action/
DONE_PATH=vault/Done/
NEEDS_APPROVAL_PATH=vault/Needs_Approval/
PLANS_PATH=vault/Plans/
LINKEDIN_POSTS_PATH=vault/LinkedIn_Posts/
COMPANY_HANDBOOK_PATH=vault/Company_Handbook/
