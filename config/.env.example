# Platinum Tier AI Employee - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# CLOUD AGENT CONFIGURATION
# ============================================================================

# Gmail API Credentials (for cloud agent monitoring)
GMAIL_CREDENTIALS_PATH=./config/gmail_credentials.json
GMAIL_TOKEN_PATH=./config/gmail_token.json
GMAIL_CHECK_INTERVAL=120

# LinkedIn API Credentials (for cloud agent monitoring)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_CHECK_INTERVAL=300

# Facebook/Instagram API Credentials (for cloud agent monitoring)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_CHECK_INTERVAL=300

# Twitter API Credentials (for cloud agent monitoring)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_CHECK_INTERVAL=300

# ============================================================================
# LOCAL AGENT CONFIGURATION (SECRETS - NEVER SYNC TO CLOUD)
# ============================================================================

# WhatsApp Web Automation (local agent only)
WHATSAPP_SESSION_PATH=./config/whatsapp_session
WHATSAPP_HEADLESS=true

# Odoo Integration (local agent only)
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database_name
ODOO_USERNAME=your_odoo_username
ODOO_PASSWORD=your_odoo_password

# ============================================================================
# VAULT SYNCHRONIZATION
# ============================================================================

# Vault sync method: "git" or "syncthing"
VAULT_SYNC_METHOD=git

# Git configuration (if using git sync)
VAULT_GIT_REMOTE=git@github.com:your-username/your-vault-repo.git
VAULT_GIT_BRANCH=main
VAULT_SYNC_INTERVAL=60

# Syncthing configuration (if using syncthing sync)
SYNCTHING_FOLDER_ID=your_folder_id
SYNCTHING_API_KEY=your_syncthing_api_key
SYNCTHING_URL=http://localhost:8384

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================

# MCP server ports
MCP_EMAIL_PORT=3001
MCP_SOCIAL_PORT=3002
MCP_ODOO_PORT=3003

# MCP server log level: "debug", "info", "warn", "error"
MCP_LOG_LEVEL=info

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Development mode (disables all external API calls)
DEVELOPMENT_MODE=false

# Dry-run mode (logs actions without executing)
DRY_RUN_MODE=false

# Agent log level: "DEBUG", "INFO", "WARNING", "ERROR"
LOG_LEVEL=INFO

# Approval timeout (seconds)
APPROVAL_TIMEOUT=86400

# ============================================================================
# ORCHESTRATION
# ============================================================================

# Orchestration dashboard port
DASHBOARD_PORT=8080

# Orchestration API port
ORCHESTRATION_API_PORT=8081
